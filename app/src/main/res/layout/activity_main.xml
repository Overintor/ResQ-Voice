<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                               -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <!-- ===================================================== -->
        <!-- TOP BAR                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- MENU BUTTON -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#334155"
                    android:padding="10dp"
                    android:contentDescription="เปิดเมนู"/>

            </com.google.android.material.card.MaterialCardView>


            <!-- TITLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESQ-VOICE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvCurrentTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="สถานการณ์: CPR (ปั๊มหัวใจ)"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

            </LinearLayout>


            <!-- MEDICAL ID -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMedicalId"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🩺"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:cornerRadius="20dp"
                app:strokeColor="#CBD5E1"
                android:textColor="#475569"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- QUICK ACTIONS                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- CALL -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall1669"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📞 1669"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#166534"
                app:backgroundTint="#DCFCE7"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp"/>


            <!-- GPS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGpsShare"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📍 GPS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#1E40AF"
                app:backgroundTint="#DBEAFE"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp"/>


            <!-- FLASH -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlashlight"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔦 ไฟฉาย"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#92400E"
                app:backgroundTint="#FEF3C7"
                app:cornerRadius="14dp"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- BLE STATUS                                             -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:padding="10dp"
            android:background="#F1F5F9"
            android:text="📡 BLE: กำลังตรวจสอบ..."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:gravity="center"/>


        <!-- ===================================================== -->
        <!-- GUIDE IMAGE                                            -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgGuide"
                    android:layout_width="match_parent"
                    android:layout_height="219dp"
                    android:contentDescription="ภาพประกอบการช่วยเหลือ"
                    android:scaleType="fitCenter"
                    android:src="@drawable/guide_cpr"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="#CC0F172A"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="คู่มือการช่วยเหลือ"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- INSTRUCTION                                           -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeColor="#FECACA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="22sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="กดปุ่ม SOS เพื่อเริ่มระบบเสียงนำทาง CPR"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#B91C1C"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- SOS AREA                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sos_ring"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:text="SOS&#10;เริ่ม CPR"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    app:backgroundTint="#DC2626"
                    app:cornerRadius="90dp"
                    app:elevation="10dp"
                    app:rippleColor="#FFFFFF"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="แตะเพื่อเริ่มระบบช่วยเหลือ"
                android:textSize="12sp"
                android:textColor="#94A3B8"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- DRAWER                                                    -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF">


        <!-- ===================================================== -->
        <!-- DRAWER HEADER                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="20dp"
            android:background="#0F172A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨"
                android:textSize="34sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ResQ-Voice"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="ระบบช่วยชีวิตด้วยเสียง"
                android:textSize="12sp"
                android:textColor="#94A3B8"/>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- DRAWER MENU                                           -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="สถานการณ์ฉุกเฉิน"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="10dp"
                android:paddingStart="6dp"/>


            <!-- CPR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuCpr"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="❤️   CPR (ปั๊มหัวใจ)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#B91C1C"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="14dp"
                android:layout_marginBottom="6dp"/>


            <!-- CHOKING -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuChoking"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🗣️   สำลักอาหาร"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="6dp"/>


            <!-- BLEEDING -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuBleeding"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🩸   ห้ามเลือด"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="6dp"/>


            <!-- SEIZURE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSeizure"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚡   อาการชัก"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="14dp"/>


            <!-- ================================================= -->
            <!-- LANGUAGE SECTION                                   -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ภาษา / Language"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="10dp"
                android:paddingStart="6dp"/>


            <!-- LANGUAGE BUTTON -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLanguage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🌐  ไทย / English"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#334155"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                app:cornerRadius="14dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"/>


            <!-- CURRENT LANGUAGE -->

            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ภาษาปัจจุบัน: ไทย"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>